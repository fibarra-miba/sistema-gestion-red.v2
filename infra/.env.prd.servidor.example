# Plantilla de PRD en el SERVIDOR (red.fiba-soluciones.com.ar). En el host:
#   cp infra/.env.prd.servidor.example infra/.env.prd && chmod 600 infra/.env.prd
#   # generar cada password con:  openssl rand -hex 16
# y reemplazar cada CHANGE_ME (el launcher no levanta mientras quede alguno).
# Detalle del despliegue en README §Servidor y docs/servidor.md.
# El admin de la app NO viene en la base: crearlo con  ./red prd create-admin

# Con esto el launcher usa docker-compose.servidor.yml (imágenes de GHCR,
# Let's Encrypt, socket-proxy) en lugar del proxy local.
RED_MODO=servidor

# Tag a desplegar: el sha-<commit corto> que publicó el CI (README §Imágenes).
# Desplegar otra versión o volver atrás = cambiar esto y `./red prd up`.
RED_TAG=CHANGE_ME_sha-xxxxxxx

COMPOSE_PROJECT_NAME=red_prd

POSTGRES_USER=red_prd
POSTGRES_PASSWORD=CHANGE_ME_password_fuerte
POSTGRES_DB=red_prd
RED_SEED=0

APP_HOST=red.fiba-soluciones.com.ar
HTTP_PORT=80
HTTPS_PORT=443

# Let's Encrypt: acme-staging-v02 (certificado de prueba, el navegador avisa) para
# validar el circuito; acme-v02 (producción) recién cuando el de prueba salió bien.
LETSENCRYPT_CA=acme-staging-v02

# Token de Cloudflare con permiso SOLO de editar DNS de la zona fiba-soluciones.com.ar.
# Se guarda en un archivo fuera del repo (chmod 600), nunca acá ni por chat.
CF_DNS_API_TOKEN_FILE=/srv/red/secretos/cf_dns_api_token

# Mismo origen para front y API: sin CORS (ver .env.prd.example).
CORS_ORIGINS=
SESSION_COOKIE_NAME=red_session_prd
SESSION_COOKIE_SECURE=true

# Solo lo usa el build de la imagen del front (ya horneado en GHCR); queda por
# coherencia con el resto de los ambientes.
VITE_API_BASE_URL=/api

# Asistente de Telegram (docs/asistente.md). Vacío = apagado. Generar en el host con:
#   openssl rand -hex 32   (el mismo valor va en la credencial "Asistente RED - secreto" de n8n)
ASISTENTE_SECRETO=
