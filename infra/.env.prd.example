# Plantilla de PRD. Copiar a infra/.env.prd y reemplazar TODOS los secretos.
#   cp infra/.env.prd.example infra/.env.prd
#   # generar passwords fuertes, p. ej.:  openssl rand -hex 16

COMPOSE_PROJECT_NAME=red_prd

POSTGRES_USER=red_prd
POSTGRES_PASSWORD=CHANGE_ME_password_fuerte
POSTGRES_DB=red_prd
RED_SEED=0

# ------------------------------------------------------
# Host público del producto. Todo (front y API) vive en ESTE único origen:
#   https://APP_HOST/        -> frontend
#   https://APP_HOST/api/*   -> backend
# En el servidor va el dominio real (p. ej. red.midominio.com).
# ------------------------------------------------------
APP_HOST=red.localhost

# Puertos que publica el proxy en el host. Son los ÚNICOS puertos publicados:
# postgres no se expone (vive en la red interna `data`).
HTTP_PORT=80
HTTPS_PORT=443

PGADMIN_EMAIL=admin@redisp.com   # evitar dominios reservados (.local) — pgAdmin los rechaza
PGADMIN_PASSWORD=CHANGE_ME_password_fuerte

# Vacío a propósito: con front y API en el mismo origen no hay request
# cross-origin, así que el navegador nunca pide CORS. Poner un valor acá
# reabriría una superficie que el ruteo por path ya cerró.
CORS_ORIGINS=
SESSION_COOKIE_NAME=red_session_prd
# La cookie de sesión solo viaja por HTTPS. Requiere TLS en el proxy.
SESSION_COOKIE_SECURE=true

# Relativo, no absoluto: el bundle deja de tener el dominio horneado, así que
# la misma imagen sirve en cualquier host sin reconstruir.
VITE_API_BASE_URL=/api

# ------------------------------------------------------
# Puertos directos — SOLO los usa el override de DEV, que publica cada servicio
# en el host. En PRD no se publica ninguno; quedan acá para que un mismo archivo
# sirva de referencia a los dos ambientes.
# ------------------------------------------------------
PG_PORT=5433
API_PORT=8100
FRONT_PORT=5273
PGADMIN_PORT=5150
