# ============================================================
# Sistema RED - n8n Addon
# Copiar este archivo como:
# infra/.env.n8n
# ============================================================

# ------------------------------------------------------------
# n8n HTTP local
# ------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# ------------------------------------------------------------
# URL pública para webhooks
# Necesaria para integraciones como Telegram Trigger.
#
# En local, usar una URL HTTPS pública de ngrok, Cloudflare Tunnel,
# localtunnel u otra herramienta similar.
#
# Ejemplo:
# WEBHOOK_URL=https://raulcito-demo.ngrok-free.app/
# N8N_EDITOR_BASE_URL=https://raulcito-demo.ngrok-free.app/
# ------------------------------------------------------------
WEBHOOK_URL=https://TU_URL_PUBLICA_HTTPS/
N8N_EDITOR_BASE_URL=https://TU_URL_PUBLICA_HTTPS/

# ------------------------------------------------------------
# Seguridad interna de credenciales n8n
# IMPORTANTE:
# - Cambiar esta clave en cada instalación real.
# - No compartirla.
# - No perderla si ya existen credenciales creadas en n8n.
# - Si cambia, las credenciales guardadas pueden quedar inutilizables.
# ------------------------------------------------------------
N8N_ENCRYPTION_KEY=cambiar_esta_clave_larga_local_sistema_red_n8n_2026

# ------------------------------------------------------------
# Zona horaria
# ------------------------------------------------------------
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires

# ------------------------------------------------------------
# PostgreSQL exclusivo para n8n
# ------------------------------------------------------------
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n_password_local
