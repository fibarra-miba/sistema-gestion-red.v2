    {
      "id": "a0000001-0000-4000-8000-00000000000a",
      "name": "Texto del audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// La transcripción reemplaza al texto; el resto del contexto sigue igual.\nconst buscar = (o) => {\n  if (typeof o === 'string') return o;\n  if (Array.isArray(o)) { for (const x of o) { const t = buscar(x); if (t) return t; } return ''; }\n  if (o && typeof o === 'object') {\n    if (typeof o.text === 'string') return o.text;\n    for (const v of Object.values(o)) { const t = buscar(v); if (t) return t; }\n  }\n  return '';\n};\nconst c = $('Contexto').first().json;\nreturn { json: { ...c, texto: '(audio) ' + buscar($json).trim() } };"
      }
    },
