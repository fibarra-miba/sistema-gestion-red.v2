      "id": "a0000001-0000-4000-8000-000000000002",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Comandos y mensajes que no necesitan modelo (docs/asistente.md §3.6).\nconst m = $json.message ?? {};\nconst texto = (m.text ?? m.caption ?? '').trim();\nconst comando = texto.startsWith('/') ? texto.slice(1).split(/[\\s@]/)[0].toLowerCase() : '';\nconst tgId = m.from?.id;\nconst audio = m.voice ?? m.audio ?? null;\nconst AYUDA = 'Soy el asistente de Sistema RED. Preguntame por texto o con un audio, por ejemplo:\\n' +\n  '• ¿Qué datos tiene Juan Pérez?\\n• ¿Qué instalaciones hay esta semana?\\n• ¿Cómo venimos de deuda?\\n• ¿Qué planes hay y a qué precio?\\n\\n' +\n  `Tu ID de Telegram: ${tgId}`;\nlet respuesta = '';\nif (comando === 'id') respuesta = `Tu ID de Telegram es ${tgId}`;\nelse if (['start', 'ayuda', 'help'].includes(comando)) respuesta = AYUDA;\nelse if (comando) respuesta = 'No conozco ese comando. Probá /ayuda.';\nelse if (!texto && !audio) respuesta = 'Por ahora entiendo mensajes de texto y audios.';\nelse if (audio && (audio.duration ?? 0) > 120) respuesta = 'El audio es muy largo: mandame uno de hasta 2 minutos.';\nreturn { json: { chat_id: m.chat?.id, tg_id: tgId, texto, audio_id: audio?.file_id ?? '', respuesta } };"
      }
    },
