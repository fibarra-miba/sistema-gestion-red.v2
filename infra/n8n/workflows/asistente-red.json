      "id": "a0000001-0000-4000-8000-000000000005",
      "name": "Contexto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        400
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Cookie de sesión del usuario vinculado + contexto variable (va al FINAL del prompt).\n// PRD: cambiar COOKIE por el SESSION_COOKIE_NAME de infra/.env.prd.\nconst COOKIE = 'red_session_dev';\nconst p = $('Preparar').first().json;\nconst r = $json;\nif (r.statusCode !== 200) {\n  let respuesta = 'El sistema no está disponible ahora. Probá en un rato.';\n  if (r.statusCode === 404) respuesta = `Tu cuenta de Telegram no está vinculada a RED. Pasale este ID a un administrador: ${p.tg_id}`;\n  else if (r.statusCode === 403 && r.body?.detail) respuesta = r.body.detail;\n  return { json: { ok: false, respuesta } };\n}\nconst u = r.body.usuario;\nconst ahora = $now.setZone('America/Argentina/Buenos_Aires').setLocale('es');\nreturn { json: {\n  ok: true,\n  cookie: `${COOKIE}=${r.body.token}`,\n  usuario: `${u.nombre} (${u.rol})`,\n  hoy: ahora.toFormat(\"yyyy-MM-dd (cccc) HH:mm\"),\n  texto: p.texto,\n  audio_id: p.audio_id,\n} };"
      }
