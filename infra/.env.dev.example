# Plantilla de DEV. Copiar a infra/.env.dev y reemplazar cada CHANGE_ME
# (el launcher no levanta mientras quede alguno). Detalle en docs/secretos.md.
#   cp infra/.env.dev.example infra/.env.dev && chmod 600 infra/.env.dev
#   # generar cada password con:  openssl rand -hex 16

COMPOSE_PROJECT_NAME=red_dev

POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mi_base
RED_SEED=1

PG_PORT=5432
API_PORT=8000
FRONT_PORT=5173
PGADMIN_PORT=5050

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME

CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=red_session_dev

VITE_API_BASE_URL=http://localhost:8000
APP_HOST=red-dev.localhost
SESSION_COOKIE_SECURE=false
