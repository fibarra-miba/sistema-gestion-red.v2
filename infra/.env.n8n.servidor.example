# Plantilla de n8n en el SERVIDOR. En el host:
#   cp infra/.env.n8n.servidor.example infra/.env.n8n && chmod 600 infra/.env.n8n
# y reemplazar cada CHANGE_ME. Ver infra/docker-compose.n8n.servidor.yml.

# El editor se usa por túnel SSH (http://localhost:5678 en la PC).
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/

# URL pública con la que n8n arma las URLs de sus webhooks (Telegram, etc.).
# Traefik publica solo /webhook/... de este host.
WEBHOOK_URL=https://red.fiba-soluciones.com.ar/

# Cifra las credenciales guardadas en n8n. En el corte se usa la MISMA que la VM
# si se migran credenciales cifradas; si se reingresan a mano, una nueva:
#   openssl rand -hex 32
# Sin ella las credenciales guardadas no se pueden abrir: va al gestor de
# contraseñas del titular, nunca por chat ni git.
N8N_ENCRYPTION_KEY=CHANGE_ME

GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
# openssl rand -hex 16
N8N_DB_PASSWORD=CHANGE_ME
